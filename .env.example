# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real tokens.

# From the Discord Developer Portal, under your application's Bot tab
DISCORD_TOKEN=

# From the Discord Developer Portal, General Information tab
DISCORD_CLIENT_ID=

# Right-click your test server in Discord (with Developer Mode on) and Copy Server ID
# Used so slash commands register instantly to your test server during development,
# instead of taking up to an hour to propagate globally
DISCORD_GUILD_ID=
